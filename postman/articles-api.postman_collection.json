{
  "info": {
    "_postman_id": "5a8dd5d0-7a6e-4e9d-9f06-articles-api",
    "name": "Articles API - Course Submission",
    "description": "Collection untuk menguji endpoint articles dengan filter source, title, limit, dan total article.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5050"
    }
  ],
  "item": [
    {
      "name": "Get all articles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/articles"
      }
    },
    {
      "name": "Filter by source",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/articles?source=bbc"
      }
    },
    {
      "name": "Filter by title",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/articles?title=philosophy"
      }
    },
    {
      "name": "Limit results",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/articles?limit=3"
      }
    },
    {
      "name": "Combined filters",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/articles?source=nytimes&title=attention&limit=5"
      }
    },
    {
      "name": "Get article totals",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/articles/total"
      }
    },
    {
      "name": "Invalid limit (400 expected)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/articles?limit=abc"
      }
    }
  ]
}
